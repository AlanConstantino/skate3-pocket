<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:installLocation="auto">

    <!-- The renderer is Vulkan only; there is no GLES path to fall back to. -->
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x00401000" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Only for fetching Title Update 3, which the game cannot boot without
         and which is not shipped inside this app. Nothing else uses it. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:appCategory="game"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:extractNativeLibs="false"
        android:theme="@style/Theme.Skate3">

        <!-- The launcher: finds or installs the game data, then hands over. -->
        <activity
            android:name=".SetupActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The game. singleTask because relaunching over a live session would
             abandon the SurfaceView the running SDL thread still holds. -->
        <activity
            android:name=".Skate3Activity"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:resizeableActivity="false"
            android:preferMinimalPostProcessing="true"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation|density">
            <!-- SDL reads its own orientation preference from here and would
                 otherwise override the activity's landscape declaration,
                 because its host window counts as resizable. -->
            <meta-data android:name="SDL_ENV.SDL_ORIENTATIONS" android:value="LandscapeLeft LandscapeRight" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
            </intent-filter>
        </activity>

        <!-- Applying a setting that needs a restart: this runs in its own
             process, so it survives the game process exiting and can start it
             again. -->
        <activity
            android:name=".RestartActivity"
            android:exported="false"
            android:process=":restart"
            android:theme="@android:style/Theme.NoDisplay"
            android:excludeFromRecents="true" />
    </application>
</manifest>
